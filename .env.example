# ─── Required ────────────────────────────────────────────────────────────
# A missing one of these stops the process at startup, and config.Validate
# reports all of them together rather than one restart at a time.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=carwash

# At least 32 characters. Generate one, do not think one up:
#   openssl rand -base64 48
TOKEN_SECRET=

# ─── Server ──────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8090
TOKEN_EXPIRY_HOURS=12

# The business day every report is cut on. An IANA zone name, embedded in
# the binary (see config.go), so it resolves on Windows and in a scratch
# container as well as on Linux.
TIMEZONE=Asia/Ulaanbaatar

# ─── Optional: each blank value disables exactly one feature ─────────────
# Whatever is switched off is logged at WARN on startup and reported by
# GET /readyz for as long as the process runs.

# The first manager, created only when the users collection has none. Both
# halves are needed; the password must be at least 8 characters. Without
# them a fresh database has nobody who can log in.
MANAGER_NAME=Manager
MANAGER_EMAIL=
MANAGER_PASSWORD=

# The single-page console at GET /demo. Unauthenticated by nature, so
# config.Validate REFUSES to start with APP_ENV=production and this true.
# Defaults to true outside production.
DEMO_CONSOLE=true

# ─── Scheduling ──────────────────────────────────────────────────────────
# Granularity of the booking slots offered, in minutes. Anchored to the
# start of each shift, so 15 gives 09:00, 09:15, 09:30.
SLOT_STEP_MIN=15
MAX_BOOKING_DAYS_AHEAD=30

# ─── CORS ────────────────────────────────────────────────────────────────
# Exact browser origins allowed to call this API with credentials, comma
# separated. Blank means no cross-origin browser access at all, which is
# correct when the UI is served from the same host. There is no wildcard:
# these routes carry bearer tokens.
CORS_ORIGINS=

# ─── Rate limiting ───────────────────────────────────────────────────────
# Per client IP, per named route group, in this process. Behind more than
# one replica the effective limit multiplies by the replica count — see
# middleware.RateLimiter.
RATE_LIMIT_ENABLED=true
AUTH_RATE_PER_MINUTE=10
BOOKING_RATE_PER_MINUTE=30
RATE_LIMIT_BURST=5
