# ─── Required ────────────────────────────────────────────────────────────
# A missing one of these stops the process at startup, and config.Validate
# reports all of them together rather than one restart at a time.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=carwash

# At least 32 characters. Generate one, do not think one up:
#   openssl rand -base64 48
TOKEN_SECRET=

# ─── Server ──────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8090
TOKEN_EXPIRY_HOURS=12

# The business day every report is cut on. An IANA zone name, embedded in
# the binary (see config.go), so it resolves on Windows and in a scratch
# container as well as on Linux.
TIMEZONE=Asia/Ulaanbaatar

# ─── Optional: each blank value disables exactly one feature ─────────────
# Whatever is switched off is logged at WARN on startup and reported by
# GET /readyz for as long as the process runs.

# The first manager, created only when the users collection has none. Both
# halves are needed; the password must be at least 8 characters. Without
# them a fresh database has nobody who can log in.
MANAGER_NAME=Manager
MANAGER_EMAIL=
MANAGER_PASSWORD=

# The single-page console at GET /demo. Unauthenticated by nature, so
# config.Validate REFUSES to start with APP_ENV=production and this true.
# Defaults to true outside production.
DEMO_CONSOLE=true

# ─── Scheduling ──────────────────────────────────────────────────────────
# Granularity of the booking slots offered, in minutes. Anchored to the
# start of each shift, so 15 gives 09:00, 09:15, 09:30.
SLOT_STEP_MIN=15
MAX_BOOKING_DAYS_AHEAD=30

# ─── CORS ────────────────────────────────────────────────────────────────
# Exact browser origins allowed to call this API with credentials, comma
# separated. Blank means no cross-origin browser access at all, which is
# correct when the UI is served from the same host. There is no wildcard:
# these routes carry bearer tokens.
CORS_ORIGINS=

# ─── Rate limiting ───────────────────────────────────────────────────────
# Per client IP, per named route group, in this process. Behind more than
# one replica the effective limit multiplies by the replica count — see
# middleware.RateLimiter.
RATE_LIMIT_ENABLED=true
AUTH_RATE_PER_MINUTE=10
BOOKING_RATE_PER_MINUTE=30
RATE_LIMIT_BURST=5

# ─────────────────────────────────────────────────────────────────────────────
# The platform link (tenantcore).
#
# Where this service asks who a tenant is and what their plan permits. One
# call answers both: tenantcore owns the tenants collection, so this service
# keeps no copy to drift out of step with theirs.
#
# Blank leaves every /api/v1 route answering 503 FEATURE_UNAVAILABLE — the
# process still starts and still serves /healthz and /readyz, and says on
# both that it cannot resolve tenants. A service that refuses to boot tells
# an operator far less than one that boots and explains itself.
# ─────────────────────────────────────────────────────────────────────────────

TENANTCORE_URL=http://localhost:8090
# From POST /api/v1/admin/service-clients on tenantcore. Shown once, there.
# One key per product service, never a shared secret: when this one leaks,
# this one is revoked and nothing else has to be redeployed.
TENANTCORE_SERVICE_KEY=

# How long an entitlement is trusted before refetching, and how long a stale
# one may still be served while tenantcore is unreachable.
#
# The grace window is the important one. When the platform is down this
# service keeps answering from cache and marks /readyz degraded, rather than
# telling paying customers they have not paid. Past the window it fails
# honestly instead of serving an entitlement from an hour ago forever.
ENTITLEMENT_TTL=60s
ENTITLEMENT_GRACE=15m

# The entitlement key this service checks for. It must match the name in a
# plan MODULES list on tenantcore.
CARWASH_MODULE=carwash

# The tenant the startup manager bootstrap and `make seed` belong to.
#
# "Create the first manager at startup" was a single-business idea and does
# not survive multi-tenancy: there is no longer one business to create a
# manager for. This names one, for development and demos. Provisioning a
# manager for a tenant that signs up in production is a real gap and wants a
# machine-to-machine route the platform calls when a tenant buys the module.
BOOTSTRAP_TENANT_ID=
